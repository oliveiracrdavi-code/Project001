# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — 4 planos em BRL (gerados via scripts/stripe-fixtures.sh)
STRIPE_PRICE_COMECAR=price_...
STRIPE_PRICE_PROFISSIONAL=price_...
STRIPE_PRICE_INTELIGENTE=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Resend (e-mail para lembretes e confirmações)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Agenda Boa <noreply@agendaboa.com.br>

# Canal de lembretes: 'email' ou 'whatsapp'
REMINDER_CHANNEL=email

# Evolution API (WhatsApp — opcional, use apenas se REMINDER_CHANNEL=whatsapp)
EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=your-api-key
EVOLUTION_INSTANCE_NAME=your-instance

# Cron
CRON_SECRET=seu-segredo-aleatorio-forte-de-32-chars-minimo

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
